# Zurg config (zurg-testing v1.0). Generated by install.sh from config.yml.template.
zurg: v1
token: __RD_TOKEN__

# Listen inside the container's own network namespace; host exposure is set in
# docker-compose.yml (127.0.0.1 only). Don't change to 127.0.0.1 or rclone can't connect.
host: "[::]"
port: 9999

# WebDAV basic auth, must match rclone/rclone.conf
username: zurg
password: __WEBDAV_PASS__

check_for_changes_every_secs: 10
enable_repair: true
repair_every_mins: 60
retain_folder_name_extension: false
retain_rd_torrent_name: false
rclone_enabled: false

directories:
  anime:
    group_order: 10
    group: media
    filters:
      - regex: /\b[a-fA-F0-9]{8}\b/
      - any_file_inside_regex: /\b[a-fA-F0-9]{8}\b/
  shows:
    group_order: 20
    group: media
    filters:
      - has_episodes: true
  movies:
    group_order: 30
    group: media
    only_show_the_biggest_file: true
    filters:
      - regex: /.*/
